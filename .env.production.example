# Copy to .env.production and set real values. Never commit the filled file.
DOMAIN=
ACME_EMAIL=
APP_ORIGIN=https://YOUR_DOMAIN
POSTGRES_PASSWORD=
# Password must be URI-encoded when embedded here.
DATABASE_URL=postgresql://modern_airbnd:REPLACE_PASSWORD@postgres:5432/modern_airbnd
SESSION_SECRET=
# Single quotes prevent $ characters in Argon2 hashes being interpolated by Compose.
ADMIN_PASSWORD_HASH=''
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

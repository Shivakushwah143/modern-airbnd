# Copy to .env on the VPS and set real values. Never commit the filled file.
APP_ORIGIN=https://YOUR_DOMAIN
# External Neon PostgreSQL URL. Do not point production at a local compose DB.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SESSION_SECRET=
# Single quotes prevent $ characters in Argon2 hashes being interpolated by Compose.
ADMIN_PASSWORD_HASH=''
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
